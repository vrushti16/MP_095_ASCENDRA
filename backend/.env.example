# ASCENDRA Backend Environment Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL / Neon Database Connection
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-pooler.us-east-2.aws.neon.tech/ascendra_db?sslmode=require

# Redis Cache & Session (Set REDIS_ENABLED=false if local Redis is not installed)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Google OAuth2
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Developer B FastAPI AI Service
AI_SERVICE_URL=http://localhost:8000

# Client Origins for CORS
FRONTEND_URL=http://localhost:3000
UNITY_WEBGL_URL=http://localhost:8080

# Email / SMTP Configuration (Gmail or custom SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
EMAIL_FROM="ASCENDRA Expeditions" <your_email@gmail.com>

# OTP HMAC Pepper / Server Secret (Minimum 32 bytes)
OTP_SECRET=your_otp_hmac_secret_key_32bytes_here
