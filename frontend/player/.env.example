# =============================================================================
# ASCENDRA Player Web Client — Environment Configuration Template
# Phase 19 Preparation
# STRICT SECURITY NOTICE: Frontend environment variables are public.
# NEVER put server secrets, database URLs, Redis keys, or private keys here.
# =============================================================================

# Public API Gateway Base URL
# Development:  http://localhost:5000/api/v1
# Production:   https://<BACKEND_DOMAIN>/api/v1
PLAYER_API_BASE_URL=http://localhost:5000/api/v1

# Application Environment Mode (development | production)
PLAYER_APP_ENV=development

# Google OAuth 2.0 Web Client ID (Public Identifier)
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Firebase Web App Configuration (Placeholders)
FIREBASE_API_KEY=your_firebase_web_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_APP_ID=your_firebase_web_app_id
