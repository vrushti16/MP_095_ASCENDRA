# Public API Gateway Base URL
# Development:  http://localhost:5000/api/v1
# Production:   https://<BACKEND_DOMAIN>/api/v1
ADMIN_API_BASE_URL=http://localhost:5000/api/v1

# Application Environment Mode (development | production)
ADMIN_APP_ENV=development
