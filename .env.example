# ==============================================================================
# ASCENDRA UNIFIED ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# This template documents all environment variables used across the ASCENDRA
# microservices (Node.js API Gateway, FastAPI AI Service, PostgreSQL, Redis, and WebGL).
#
# IMPORTANT:
# 1. Copy this file to .env in local development directories as needed.
# 2. NEVER commit actual passwords, private keys, or API tokens to version control.
# 3. In cloud production (Render, Neon, Upstash), set these via platform secret managers.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# For local development: postgresql://postgres:postgres@localhost:5432/ascendra_db?sslmode=disable
# For Neon Cloud PostgreSQL: postgresql://[user]:[password]@[endpoint].neon.tech/ascendra?sslmode=require
DATABASE_URL=postgresql://ascendra_user:your_secure_password_here@localhost:5432/ascendra_db?sslmode=disable

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & TOKENS (JWT & Google OAuth)
# ------------------------------------------------------------------------------
# Cryptographically strong random string (min 32 characters)
JWT_SECRET=your_jwt_access_secret_min_32_chars_long_placeholder
JWT_ACCESS_EXPIRES=15m

# Dedicated distinct secret for refresh tokens
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long_placeholder
JWT_REFRESH_EXPIRES=7d

# Google OAuth 2.0 Client Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_placeholder.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_placeholder

# ------------------------------------------------------------------------------
# 4. REDIS CACHE & SESSION STORE (Local Redis or Upstash)
# ------------------------------------------------------------------------------
# Local: redis://localhost:6379
# Upstash/Cloud: rediss://default:[password]@[endpoint].upstash.io:6379
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 5. AI MICROSERVICE & LLM PROVIDERS (FastAPI)
# ------------------------------------------------------------------------------
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=5000

# OpenAI API Key & Model Configuration
OPENAI_API_KEY=your_openai_api_key_placeholder
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key & Model Configuration
GEMINI_API_KEY=your_gemini_api_key_placeholder
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 6. CLIENT & CORS NETWORKING
# ------------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
UNITY_WEBGL_URL=http://localhost:8080
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:8080
